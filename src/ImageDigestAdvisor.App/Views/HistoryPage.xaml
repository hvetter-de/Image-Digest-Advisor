<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ImageDigestAdvisor.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ImageDigestAdvisor.App.ViewModels"
    xmlns:local="using:ImageDigestAdvisor.App.Views">

    <Page.Resources>
        <DataTemplate x:Key="PropertyRowTemplate" x:DataType="vm:PropertyRow">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Name}" Style="{StaticResource PropertyNameStyle}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{x:Bind Value}" Style="{StaticResource PropertyValueStyle}"
                           FontFamily="{x:Bind local:AnalyzePage.MonoFontIf(Monospace)}"
                           FontWeight="{x:Bind local:AnalyzePage.WeightIf(Emphasis)}" Visibility="{x:Bind HasNoLink}" />
                <HyperlinkButton Grid.Column="1" Content="{x:Bind Value}" NavigateUri="{x:Bind LinkUri}"
                                 Padding="0" Margin="0,-4,0,4" Visibility="{x:Bind HasLink}" />
            </Grid>
        </DataTemplate>

        <!-- One image in the history: summary line, details when expanded. -->
        <DataTemplate x:Key="EntryTemplate" x:DataType="vm:HistoryEntryViewModel">
            <Expander IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Margin="0,0,0,4" Padding="16,12">
                <Expander.Header>
                    <Grid ColumnSpacing="12" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" Padding="0" VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Select to compare" AutomationProperties.Name="Select to compare" />
                        <TextBlock Grid.Column="1" Text="{x:Bind DateText, Mode=OneWay}" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="{x:Bind DateTooltip, Mode=OneWay}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ShortDigest}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"
                                           ToolTipService.ToolTip="{x:Bind Entry.Digest}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind OtherTags}" Visibility="{x:Bind HasOtherTags}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind SeenText}" Visibility="{x:Bind HasSeenText}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border CornerRadius="10" Padding="10,3" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsCurrent}">
                                <TextBlock Text="Current" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <Border CornerRadius="10" Padding="10,3" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" Visibility="{x:Bind IsUserImage}">
                                <TextBlock Text="Your image" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="{x:Bind SizeText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="Compressed size for this platform" />
                        <TextBlock Grid.Column="5" Text="{x:Bind DeltaText, Mode=OneWay}" Foreground="{x:Bind DeltaBrush, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="Size change from the previous release" />
                    </Grid>
                </Expander.Header>

                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind IsLoadingDetails, Mode=OneWay}">
                        <ProgressRing IsActive="{x:Bind IsLoadingDetails, Mode=OneWay}" Width="16" Height="16" />
                        <TextBlock Text="Loading image details…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind LoadError, Mode=OneWay}" Visibility="{x:Bind HasLoadError, Mode=OneWay}" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

                    <Grid ColumnSpacing="8" Padding="10,8" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind PinnedReference}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                   IsTextSelectionEnabled="True" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Click="Copy_Click" ToolTipService.ToolTip="Copy the pinned reference" AutomationProperties.Name="Copy reference">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    <TextBlock Text="Copy" />
                                </StackPanel>
                            </Button>
                            <Button Click="CheckDigest_Click" ToolTipService.ToolTip="Run the full check on this image" AutomationProperties.Name="Check this digest">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                                    <TextBlock Text="Check this digest" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="10" Visibility="{x:Bind HasCard, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6" Padding="10,3" VerticalAlignment="Center"
                                        Visibility="{x:Bind Card.IsSecurityBusy, Mode=OneWay, FallbackValue=Collapsed}">
                                <ProgressRing IsActive="{x:Bind Card.IsSecurityBusy, Mode=OneWay, FallbackValue=False}" Width="16" Height="16" MinWidth="16" MinHeight="16" />
                                <TextBlock Text="Checking CVEs…" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Click="SecurityChip_Click" Padding="10,2" CornerRadius="10" MinHeight="0" BorderThickness="0"
                                    Background="{x:Bind Card.SecurityBackground, Mode=OneWay}"
                                    Visibility="{x:Bind Card.IsSecurityChipVisible, Mode=OneWay, FallbackValue=Collapsed}"
                                    ToolTipService.ToolTip="{x:Bind Card.SecurityTooltip, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind Card.SecurityText, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="{x:Bind Card.SecurityGlyph, Mode=OneWay}" FontSize="12" Foreground="{x:Bind Card.SecurityForeground, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind Card.SecurityText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{x:Bind Card.SecurityForeground, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind Card.Properties, Mode=OneWay}" ItemTemplate="{StaticResource PropertyRowTemplate}" />
                        <ItemsControl ItemsSource="{x:Bind Card.Sections, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DetailSection">
                                    <Expander Header="{x:Bind Header}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,6">
                                        <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource PropertyRowTemplate}" />
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Expander>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer x:Name="Scroller">
        <StackPanel Padding="24,16,24,32" Spacing="16" MaxWidth="1400">

            <!-- Header -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Click="Back_Click" VerticalAlignment="Top" Margin="0,4,0,0" ToolTipService.ToolTip="Back to the check" AutomationProperties.Name="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.RepositoryText}" FontFamily="{StaticResource MonoFont}" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.SourceText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="20" Height="20" />
                <TextBlock Text="Looking for earlier images of this tag…" VerticalAlignment="Center" />
            </StackPanel>

            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                     Title="Could not load the history" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
                <InfoBar IsOpen="{x:Bind ViewModel.HasNoReleaseTags, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasNoReleaseTags, Mode=OneWay}"
                         IsClosable="False" Severity="Informational"
                         Title="No release history published" Message="{x:Bind ViewModel.NoReleaseTagsText, Mode=OneWay}" />

                <TextBlock Text="{x:Bind ViewModel.Notes, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasNotes, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- Size over time -->
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasChart, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="Size over time" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Current" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.HasUserImageInChart, Mode=OneWay}">
                                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Your image" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ChartEntries}" Height="72">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HistoryEntryViewModel">
                                        <Button Click="Bar_Click" Padding="0" MinWidth="0" MinHeight="0" Width="14" Height="72" Background="Transparent"
                                                BorderThickness="0" VerticalContentAlignment="Bottom"
                                                ToolTipService.ToolTip="{x:Bind BarTooltip, Mode=OneWay}" AutomationProperties.Name="{x:Bind Title}">
                                            <Rectangle Width="12" Height="{x:Bind BarHeight, Mode=OneWay}" RadiusX="2" RadiusY="2" Fill="{x:Bind BarBrush}"
                                                       VerticalAlignment="Bottom" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="Oldest on the left. Click a bar to open that image." Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Compare -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Releases" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.CompareHint, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Click="Compare_Click" IsEnabled="{x:Bind ViewModel.CanCompare, Mode=OneWay}" AutomationProperties.Name="Compare">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                                <TextBlock Text="Compare" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <ItemsControl x:Name="ReleasesList" ItemsSource="{x:Bind ViewModel.Releases}" ItemTemplate="{StaticResource EntryTemplate}" />

                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasUntagged, Mode=OneWay}">
                    <TextBlock Text="Earlier images without a tag" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="No tag points to these images any more. They're listed because you checked them, or because this app saw the tag point to them. Images can still be pulled by digest unless the publisher deleted them." />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Untagged}" ItemTemplate="{StaticResource EntryTemplate}" />
                </StackPanel>

                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Text="Registries don't keep a history of moving tags. The list is built from release tags the publisher pushed next to the tag, plus the digests this app saw. Older images that no tag points to can't be listed." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
