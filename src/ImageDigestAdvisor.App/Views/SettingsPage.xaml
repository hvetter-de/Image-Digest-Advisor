<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ImageDigestAdvisor.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,32" Spacing="16" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Updates" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock>
                        <Run Text="Installed version: " /><Run Text="{x:Bind Updates.CurrentVersion}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Text="{x:Bind Updates.StatusText, Mode=OneWay}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar Value="{x:Bind Updates.Progress, Mode=OneWay}" Maximum="100" MaxWidth="400" HorizontalAlignment="Left"
                                 Width="400" Visibility="{x:Bind Updates.IsBusy, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind Updates.IsInstalled}">
                        <Button Content="Check for updates" Command="{x:Bind Updates.CheckCommand}" />
                        <Button Content="Restart and update" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind Updates.RestartAndUpdateCommand}"
                                Visibility="{x:Bind Updates.IsReadyToInstall, Mode=OneWay}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoUpdateToggle" Header="Check for updates when the app starts"
                                  Toggled="AutoUpdateToggle_Toggled" Visibility="{x:Bind Updates.IsInstalled}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Known vulnerabilities" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Checks each image for known vulnerabilities (CVEs). The app reads the SBOM (list of installed packages) that the registry publishes with the image and looks the packages up in the free osv.dev database. Only package names and versions are sent to osv.dev, never image names or credentials. Results are cached for 24 hours. Images without a published SBOM, such as Microsoft Container Registry images, can't be checked." />
                    <ToggleSwitch x:Name="VulnerabilityToggle" Header="Check images for known vulnerabilities" Toggled="VulnerabilityToggle_Toggled" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Cache" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Manifests and image configs are cached by digest. Their content can never change, so repeated checks don't use up Docker Hub's rate limit. Tag lists are cached in memory for 10 minutes." />
                    <TextBlock x:Name="CacheInfo" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Clear cache" Click="ClearCache_Click" />
                        <Button Content="Open folder" Click="OpenCache_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Docker" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="DockerInfo" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="VersionInfo" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Privacy: The app only connects to the container registries you check (and hub.docker.com for Docker Hub tag lists), and to github.com to look for updates. If you turn on the vulnerability check, package names and versions from the image's SBOM are sent to osv.dev. Credentials are stored locally in Windows Credential Manager and are only sent to the registry they belong to. No telemetry is collected." />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Free software under the GNU General Public License v3.0 or later." />
                    <HyperlinkButton Content="Source code and releases on GitHub" NavigateUri="https://github.com/hvetter-de/Image-Digest-Advisor" Padding="0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
