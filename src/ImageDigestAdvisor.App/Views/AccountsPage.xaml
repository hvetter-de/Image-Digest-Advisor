<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ImageDigestAdvisor.App.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ImageDigestAdvisor.App.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,32" Spacing="16" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Registry accounts" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <Run Text="Accounts are optional. Public images work without any login." />
                <LineBreak />
                <Run Text="Add an account to raise Docker Hub's rate limit (anonymous use allows only a few pulls per hour) or to check private images, e.g. in Azure Container Registry. Use an access token instead of your password. Tokens are stored in Windows Credential Manager." />
                <LineBreak />
                <Run Text="Logins created with 'docker login' are used automatically and shown here as read-only. Docker does not need to be installed." />
            </TextBlock>

            <Button Style="{StaticResource AccentButtonStyle}" Click="Add_Click" AutomationProperties.Name="Add account">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Add account" />
                </StackPanel>
            </Button>

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <TextBlock Text="No accounts yet. All registries are accessed anonymously." TextWrapping="Wrap" />
            </Border>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Accounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountItemViewModel">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE77B;" FontSize="20" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Registry}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{x:Bind Username}" /><Run Text=" · " /><Run Text="{x:Bind SourceText}" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Test" Command="{x:Bind TestCommand}" />
                                    <Button Content="Remove" Command="{x:Bind RemoveCommand}" Visibility="{x:Bind CanRemove}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
